@baseUrl = http://localhost:5000
@contentType = application/json
@token = cole_o_token_aqui
@idempotencyKey = 11111111-1111-1111-1111-111111111111

### Health check
GET {{baseUrl}}/healthz

### Swagger JSON
GET {{baseUrl}}/swagger/v1/swagger.json

### OpenAPI JSON usado pelo Scalar
GET {{baseUrl}}/openapi/v1.json

### Login
POST {{baseUrl}}/api/users/authenticate
Content-Type: {{contentType}}

{
  "email": "admin@hemodinks.com",
  "senha": "Senha@123"
}

### Reset de senha por email
POST {{baseUrl}}/api/users/password/reset
Content-Type: {{contentType}}
Idempotency-Key: {{idempotencyKey}}

{
  "email": "medico@hemodinks.com"
}

### Confirmar reset de senha por token
POST {{baseUrl}}/api/users/password/reset/confirm
Content-Type: {{contentType}}
Idempotency-Key: {{idempotencyKey}}

{
  "token": "cole_o_token_aqui",
  "novaSenha": "SenhaNova@123"
}

### Listar usuarios
GET {{baseUrl}}/api/users?page=1&pageSize=10&search=&profileId=
Authorization: Bearer {{token}}

### Criar usuario medico
POST {{baseUrl}}/api/users/
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "nome": "Medico Exemplo",
  "email": "medico.exemplo@hemodinks.com",
  "telefone": "+5581999999999",
  "cpf": "12345678901",
  "crm": "123456",
  "crmUf": "PE",
  "dataNascimento": "1990-01-15T00:00:00Z",
  "perfilId": 2,
  "ativo": true
}

### Buscar usuario
GET {{baseUrl}}/api/users/1
Authorization: Bearer {{token}}

### Buscar foto de perfil do usuario
GET {{baseUrl}}/api/users/1/foto-perfil
Authorization: Bearer {{token}}

### Alterar senha do usuario autenticado
PUT {{baseUrl}}/api/users/1/password
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "senhaAtual": "Senha@123",
  "novaSenha": "SenhaAlterada@123"
}

### Dashboard resumo
GET {{baseUrl}}/api/dashboard/summary
Authorization: Bearer {{token}}

### Dashboard notificacoes
GET {{baseUrl}}/api/dashboard/notifications
Authorization: Bearer {{token}}

### Configuracao publica do sistema
GET {{baseUrl}}/api/configuracoes-sistema/current

### Foto da empresa
GET {{baseUrl}}/api/configuracoes-sistema/current/foto-empresa

### Atualizar configuracao do sistema
PUT {{baseUrl}}/api/configuracoes-sistema/current
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "nomeEmpresa": "Clinica Hemodinks",
  "fotoEmpresa": null
}

### Licenca do usuario autenticado
GET {{baseUrl}}/api/licencas/current
Authorization: Bearer {{token}}

### Consultar licenca de medico (admin)
GET {{baseUrl}}/api/licencas/users/2
Authorization: Bearer {{token}}

### Atualizar licenca de medico (admin)
PUT {{baseUrl}}/api/licencas/users/2
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "plano": "Completa",
  "status": "Ativa",
  "featuresLiberadas": [
    "Dashboard.Visualizar",
    "Pacientes.Visualizar",
    "Cbhpm.Consultar"
  ],
  "observacoes": "Liberacao manual"
}

### Liberar licenca completa para medico (admin)
POST {{baseUrl}}/api/licencas/users/2/liberar-completa
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "observacoes": "Compra confirmada"
}

### Listar eventos da agenda
GET {{baseUrl}}/api/events?from=2026-07-01T00:00:00.000Z&to=2026-07-31T23:59:59.000Z
Authorization: Bearer {{token}}

### Listar medicos da agenda
GET {{baseUrl}}/api/events/medical-users
Authorization: Bearer {{token}}

### Listar destinatarios permitidos para notificacao
GET {{baseUrl}}/api/events/notification-recipients
Authorization: Bearer {{token}}

### Criar evento com idempotencia
POST {{baseUrl}}/api/events
Authorization: Bearer {{token}}
Content-Type: {{contentType}}
Idempotency-Key: {{idempotencyKey}}

{
  "title": "Consulta de acompanhamento",
  "description": "Retorno com paciente e avaliacao de exames",
  "start": "2026-07-15T13:00:00.000Z",
  "end": "2026-07-15T14:00:00.000Z",
  "notifyMedicalProfile": true,
  "notifyUser": true,
  "reminderPeriodMinutes": 60,
  "notifyAllAllowedRecipients": false,
  "notificationUserIds": [],
  "notificationGroupIds": []
}

### Marcar notificacoes da agenda como lidas
POST {{baseUrl}}/api/events/notifications/mark-read
Authorization: Bearer {{token}}

### Atualizar evento
PUT {{baseUrl}}/api/events/1
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "title": "Consulta de acompanhamento atualizada",
  "description": "Retorno com paciente",
  "start": "2026-07-15T13:30:00.000Z",
  "end": "2026-07-15T14:30:00.000Z",
  "notifyMedicalProfile": true,
  "notifyUser": true,
  "reminderPeriodMinutes": 120,
  "notifyAllAllowedRecipients": false,
  "notificationUserIds": [],
  "notificationGroupIds": []
}

### Concluir evento
POST {{baseUrl}}/api/events/1/complete
Authorization: Bearer {{token}}

### Excluir evento
DELETE {{baseUrl}}/api/events/1
Authorization: Bearer {{token}}

### Listar pacientes
GET {{baseUrl}}/api/pacientes?page=1&pageSize=10&search=
Authorization: Bearer {{token}}

### Criar paciente
POST {{baseUrl}}/api/pacientes/
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "data": "2026-07-04T00:00:00Z",
  "nomePaciente": "Paciente Exemplo",
  "cpf": "98765432100",
  "email": "paciente.exemplo@hemodinks.com",
  "telefone": "+5581988888888",
  "dataNascimento": "1985-02-10T00:00:00Z",
  "hospital": "Hospital Exemplo",
  "medico": "Medico Exemplo",
  "convenio": "Convenio Exemplo",
  "opmeFornecedor": "Fornecedor Exemplo",
  "cbhpmCodigo": "1.01.01.01-2",
  "cbhpmPorte": "2B",
  "procedimento": "Em consultorio",
  "autorizacao": "Autorizado",
  "pagamento": "Convenio",
  "repasseGlosa": "N/A",
  "statusPago": false,
  "ativo": true
}

### Buscar paciente
GET {{baseUrl}}/api/pacientes/1
Authorization: Bearer {{token}}

### Listar observacoes do paciente
GET {{baseUrl}}/api/pacientes/1/observacoes
Authorization: Bearer {{token}}

### Criar observacao do paciente
POST {{baseUrl}}/api/pacientes/1/observacoes
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "texto": "Paciente liberado para acompanhamento.",
  "observacaoPaiId": null
}

### Marcar observacoes do paciente como lidas
POST {{baseUrl}}/api/pacientes/1/observacoes/marcar-lidas
Authorization: Bearer {{token}}

### Listar faturamentos medicos
GET {{baseUrl}}/api/faturamentos-medicos?page=1&pageSize=10&search=&medico=&convenio=&procedimento=&sortBy=recent&sortDirection=desc
Authorization: Bearer {{token}}

### Listar grupos medicos
GET {{baseUrl}}/api/grupos-medicos?page=1&pageSize=10&search=&sortBy=recent&sortDirection=desc
Authorization: Bearer {{token}}

### Listar medicos disponiveis para grupos
GET {{baseUrl}}/api/grupos-medicos/medicos
Authorization: Bearer {{token}}

### Criar grupo medico
POST {{baseUrl}}/api/grupos-medicos
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "nome": "Equipe Cirurgica Recife",
  "ativo": true,
  "medicoUserIds": [2, 5]
}

### Listar hospitais
GET {{baseUrl}}/api/hospitais
Authorization: Bearer {{token}}

### Listar convenios
GET {{baseUrl}}/api/convenios
Authorization: Bearer {{token}}

### Listar fornecedores OPME
GET {{baseUrl}}/api/opme
Authorization: Bearer {{token}}

### Consulta CBHPM
GET {{baseUrl}}/api/cbhpm?page=1&pageSize=10&codigo=1.01&procedimento=consulta&porte=2B
Authorization: Bearer {{token}}

### Importar/substituir item CBHPM (admin)
POST {{baseUrl}}/api/cbhpm/import
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "items": [
    {
      "codigo": "1.01.01.01-2",
      "procedimento": "Em consultorio",
      "porte": "2B",
      "custoOperacional": null,
      "valorReferencia": 67.82,
      "capitulo": null,
      "grupo": null
    }
  ]
}

### Solicitar exportacao assincrona
POST {{baseUrl}}/api/exports
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "tipo": "PacientesPdf",
  "payload": {
    "search": "",
    "scope": "all"
  }
}
