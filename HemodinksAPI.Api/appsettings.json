{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://hemodinks.gestao-saude.tec.br",
      "https://hemodinks-saude.vercel.app"
    ]
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "ForwardLimit": 1,
    "TrustAnyImmediateProxy": false,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "ApiDocumentation": {
    "Enabled": false
  },
  "Database": {
    "RunMigrationsOnStartup": false,
    "RunMaintenanceOnStartup": false
  },
  "EventReminders": {
    "RunHostedProcessor": false
  },
  "Seed": {
    "CbhpmOnStartup": false,
    "UsersOnStartup": false
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "HemodinksAPI",
    "Audience": "HemodinksAPI",
    "ExpirationMinutes": 30
  },
  "AuthenticationSession": {
    "IdleTimeoutMinutes": 30,
    "RefreshCookieName": "hemodinks_refresh",
    "RefreshCookieLifetimeDays": 30
  },
  "LoginProtection": {
    "MaximumFailedAttempts": 5,
    "AttemptWindowMinutes": 15,
    "LockoutMinutes": 15
  },
  "Licensing": {
    "TrialDays": 14
  },
  "Platform": {
    "SuperAdminEmails": []
  },
  "AsyncQueues": {
    "Enabled": false,
    "PasswordResetEnabled": false,
    "FileExportEnabled": false,
    "ConnectionString": "",
    "PasswordResetEmailQueueName": "password-reset-emails",
    "FileExportQueueName": "file-export-jobs"
  },
  "Email": {
    "Provider": "",
    "BrandLogoUrl": "",
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "Username": "",
      "Password": "",
      "EnableSsl": true,
      "TimeoutSeconds": 10
    },
    "FromEmail": "",
    "FromName": "Hemodinks"
  },
  "Frontend": {
    "ResetPasswordUrl": ""
  },
  "AzureStorage": {
    "ConnectionString": "",
    "ContainerName": "profile-photos",
    "PublicBaseUrl": "",
    "MaxBytes": 2097152
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/hemodinks-api-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  }
}
