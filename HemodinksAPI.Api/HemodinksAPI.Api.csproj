    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HemodinksAPI.Application\HemodinksAPI.Application.csproj" />
    <ProjectReference Include="..\HemodinksAPI.Domain\HemodinksAPI.Domain.csproj" />
    <ProjectReference Include="..\HemodinksAPI.Infrastructure\HemodinksAPI.Infrastructure.csproj" />
